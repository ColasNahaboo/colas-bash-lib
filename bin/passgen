#!/bin/bash
# shellcheck disable=SC1091,SC2155,SC2018 # source files, declare&assign

# Configuration variables, can be redefined in ~/.config/passgen.conf
deflen=24                       # 24 is future-proof against quantum computers
logdir="$HOME"/.local/state/passgen
note=
special='-%=+_^/~?.'          # warning: [$special] must be a valid regexp
[[ -e "$HOME"/.config/passgen.conf ]] && . "$HOME"/.config/passgen.conf

# Utils
lastpass(){ tail "$logdir/log";}
random-string() { # LC_ALL=C avoids unicode multibyte mess
    LC_ALL=C tr -dc "a-zA-Z1-9$special" < /dev/urandom | head -c "${1:-12}"
}
random-lower() {
    LC_ALL=C tr -dc 'a-z' < /dev/urandom | head -c 1
}
# shellcheck disable=SC2151
has(){ [[ $pass =~ [$1] ]] && return 0 || return 1;}
maxint=9223372036854775807
pass-strength(){
    local l="$1" base=$((26*2 + 9 + ${#special})) n=26 exp=1
    while ((--l > 0)); do
        if ((n >= (maxint / base))); then # int64 overflow
            ((n = n/100))
            ((exp += 2))
        fi
        ((n *= base))
    done
    if ((exp == 1)); then
        echo "$n ($((n / 10**(${#n}-1)))e$((${#n}-1)))"
    else
        ((exp += ${#n}-1))
        echo "$((n / 10**(${#n}-1)))e$exp"
    fi
}    

copy_to_clipboard() {
    local input_str="$1"
    
    if [ "$XDG_SESSION_TYPE" = "wayland" ] && command -v wl-copy >/dev/null; then
        echo -n "$input_str" | wl-copy
    elif command -v xclip >/dev/null; then
        echo -n "$input_str" | xclip -selection clipboard
    elif command -v xsel >/dev/null; then
        echo -n "$input_str" | xsel --clipboard --input
    else
        echo "Error: No clipboard utility found." >&2
        return 1
    fi
}

# Usage & Options
if [[ "$1" =~ ^- ]]; then
    if [[ "$1" == "-s" ]]; then
        echo "A password length of $2 means $(pass-strength "$2") combinations"
        exit 0
    fi
    [[ "$1" != "-l" ]] && echo "USAGE: passgen [options] [length] [note]
  Generates a password of length (default: $deflen), which starts with a lower
  case letter, then numbers, lower and upper case letters, and special
  characters that still allow the whole password to be selectable by
  double-clicking for convenience: \"$special\"
  The zero (0) character is not used, to avoid confusion with the letter O.
  Keeps a log of generated passwords in ~/.local/state/passgen/log as a reminder.
Options
  -l         lists the last passwords generated and exits.
  a number   the length of the generated password (default: $deflen).
  a string   optional note to be added to the stored password in the logfile
  -s N       prints the strength of a password generated by \"passgen N\"
             Checkers: https://quarkpass.com/checker https://qpasswordstrong.com
Last generated passwords:"
    lastpass
    exit 0
fi
if [[ $1 =~ ^[[:digit:]]+$ ]]; then len="$1"; shift
else len="$deflen"
fi
note="$*"

# Redo until we have one char of each category
while true; do
    pass="$(random-lower)$(random-string $((len - 1)))"
    has '[:lower:]' && has '[:upper:]' && has '[:digit:]' && has "$special" &&
        break
done

echo "$pass"
copy_to_clipboard "$pass"

# log result
mkdir -p "$logdir"
echo "$(date +%Y-%m-%d,%Hh%M) $pass${note:+ }$note" >>"$logdir"/log
chmod go-rwx "$logdir"/log

