#!/bin/bash

die() { echo "$@" >&2; exit 1; }

# --- backend detection ---
[[ -n $DISPLAY ]] || die "No display found"

# --- X11 desktops ---
# stdout: tab-separated index, marker (*/-), name
x11_desktops() {
    while read -r line; do
        [[ $line =~ ^([0-9]+)[[:space:]]+([*\-]).*WA:[[:space:]]*[0-9,]+[[:space:]]+[0-9x]+[[:space:]]+(.*)$ ]] &&
            printf '%s\t%s\t%s\n' "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" "${BASH_REMATCH[3]}"
    done < <(wmctrl -d)
}

# --- window classes on a given desktop ---
x11_window_classes() {
    local desk=$1
    wmctrl -lx | awk -v d="$desk" '
        $2 == d {
            split($3, a, ".")
            c = a[length(a)]
            if (!seen[c]++) print c
        }
    ' | sort | paste -sd, - | sed 's/,/, /g'
}

# --- popup menu ---
popup_menu() {
    local title=$1 width=$(( ($2 * 5) / 2))
    local curidx=$(xprop -root _NET_CURRENT_DESKTOP| awk '{print $NF}')
    local -a items=("${@:3}")
    printf '%s\n' "${items[@]}" |
        rofi -dmenu -markup -markup-rows -selected-row ${curidx:-0} \
             -p "$title" -i -no-custom \
             -theme-str "element-text { font: \"Monospace 32\"; } window { width: ${width}ch; } listview { fixed-height: false; dynamic: true; lines: 20; }" \
             -kb-custom-1 "F1" -kb-custom-2 "F2" -kb-custom-3 "F3" \
             -kb-custom-4 "F4" -kb-custom-5 "F5" -kb-custom-6 "F6" \
             -kb-custom-7 "F7" -kb-custom-8 "F8" -kb-custom-9 "F9" \
             -kb-custom-10 "F10" -kb-custom-11 "F11" -kb-custom-12 "F12" \
             -kb-element-next "" -kb-custom-13 "Tab" \
             -format i \
             2>/dev/null
}

# --- selected-row index from rofi output ---
# Handles both index output (-format i) and legacy row-text output
_parse_sel_idx() {
    local v=${1//[[:space:]]/}
    [[ $v =~ ^[0-9]+$ ]] || v=$(sed 's/<[^>]*>//g' <<<"$1" | awk '{print $1}')
    [[ $v =~ ^[0-9]+$ ]] && printf '%s\n' "$v"
}

# --- X11 switch ---
x11_switch() {
    local maxwidth output rc idx cur new
    declare -a items=()

    while true; do
        maxwidth=8
        items=()
        while IFS=$'\t' read -r idx mark name; do
            local classes display width line
            [[ $name =~ ^Workspace\ ([0-9]+)$ ]] && name="ws_${BASH_REMATCH[1]}"
            ((idx < 9)) && pad=' ' || pad=''
            ppad="$(padto "$name")"
            classes=$(x11_window_classes "$idx")
            line="$idx $pad$name$ppad| "
            ((width = ${#line} + (${#classes} / 2) + 1))
            ((width > maxwidth)) && ((maxwidth=width))
            display="<span font='Monospace 32'>$((idx + 1)) $pad$name$ppad| </span>"
            [[ -n $classes ]] && display+="<span font='Sans 16'>$classes</span>"
            items+=("$display")
        done < <(x11_desktops)

        output=$(popup_menu "Switch workspace (arrows+enter, or Fn; Tab renames)" $maxwidth "${items[@]}")
        rc=$?

        case $rc in
            0)  idx=$(_parse_sel_idx "$output") ;;
            22) # Tab: rename the highlighted workspace
                _ws_names_and_index
                idx=$(_parse_sel_idx "$output")
                # ponytail: bad index must not silently become workspace 0
                [[ -n $idx && -n ${WSN[idx]+x} ]] || idx=$(_cur_ws_idx)
                cur=${WSN[idx]}
                new=$(printf '%s\n' "$cur" | rofi -dmenu -p "Rename workspace" \
                    -filter "$cur" -format f \
                    -theme-str "element-text { font: \"Monospace 32\"; } window { width: $(( (${#cur} + 12) * 5 / 2 ))ch; } listview { fixed-height: false; dynamic: true; lines: 1; }" \
                    2>/dev/null) || { sleep 0.15; continue; }
                [[ -n $new && $new != "$cur" ]] && x11_rename_at "$idx" "$new"
                sleep 0.15   # let this rofi release its grab before relaunching
                continue ;;
            1[0-9]|2[01]) idx=$((rc - 10)) ;;  # F1-F12
            *) break ;;
        esac
        [[ -n $idx ]] && wmctrl -s "$idx"
        break
    done
}

spaces='                                                                       '
padto(){
    local l=$(( (${#1} / 4 + 1) * 4 - ${#1}))
    ((l > 0)) && echo "${spaces:0:$l}" || echo -n
}

# --- WM detection ---
wm_detect() {
    local wm
    wm=$(wmctrl -m 2>/dev/null | awk -F': ' '/^Name:/ {print $2}')
    case $wm in
        Xfwm4)                 echo "xfce" ;;
        i3)                    echo "i3" ;;
        bspwm|Bspwm)           echo "bspwm" ;;
        Mutter|"GNOME Shell")  echo "gnome" ;;
        KWin)                  echo "kde" ;;
        *)
            [[ $XDG_CURRENT_DESKTOP =~ GNOME ]] && { echo "gnome"; return; }
            [[ $XDG_CURRENT_DESKTOP =~ KDE ]]   && { echo "kde"; return; }
            echo "$wm" ;;
    esac
}

# --- per-WM workspace rename ---

_cur_ws_idx() {
    xprop -root _NET_CURRENT_DESKTOP 2>/dev/null | awk '{print $NF}'
}

_ws_names_and_index() {
    declare -ga WSN=()
    local idx mark name   # ponytail: bash dynamic scoping would clobber caller's local `idx`
    while IFS=$'\t' read -r idx mark name; do
        WSN[idx]=$name
    done < <(x11_desktops)
}

xfce_rename() {
    local idx=$1 new_name=$2
    _ws_names_and_index
    [[ -z ${WSN[idx]+x} ]] && die "Invalid workspace index"
    WSN[idx]=$new_name
    command -v xfconf-query &>/dev/null || die "xfconf-query not found"
    local -a args=()
    for n in "${WSN[@]}"; do args+=(-t string -s "$n"); done
    xfconf-query -c xfwm4 -p /general/workspace_names "${args[@]}" 2>&1
    # ponytail: xfwm4 may not republish _NET_DESKTOP_NAMES on xfconf change;
    # set it directly so the switcher/taskbar reflect the new name immediately
    _ewmh_names "${WSN[@]}"
}

i3_rename() {
    local idx=$1 new_name=$2
    _ws_names_and_index
    local old=${WSN[idx]}
    command -v i3-msg &>/dev/null || die "i3-msg not found"
    i3-msg "rename workspace \"$old\" to \"$new_name\""
}

bspwm_rename() {
    local idx=$1 new_name=$2
    command -v bspc &>/dev/null || die "bspc not found"
    bspc desktop "^$((idx + 1))" -n "$new_name"
}

gnome_rename() {
    local idx=$1 new_name=$2
    command -v gsettings &>/dev/null || die "gsettings not found"
    python3 - "$idx" "$new_name" <<'PYEOF'
import subprocess, json, sys
idx = int(sys.argv[1]); new_name = sys.argv[2]
out = subprocess.check_output(['gsettings', 'get',
    'org.gnome.desktop.wm.preferences', 'workspace-names'])
names = eval(out)  # gsettings outputs Python list syntax
if idx < len(names):
    names[idx] = new_name
subprocess.run(['gsettings', 'set',
    'org.gnome.desktop.wm.preferences', 'workspace-names',
    json.dumps(names, ensure_ascii=False)])
PYEOF
}

kde_rename() {
    local idx=$1 new_name=$2
    local cfg=kwriteconfig5
    command -v kwriteconfig6 &>/dev/null && cfg=kwriteconfig6
    command -v "$cfg" &>/dev/null || die "$cfg not found"
    command -v qdbus &>/dev/null || die "qdbus not found"
    "$cfg" --file kwinrc --group Desktops --key "Name_$idx" "$new_name"
    qdbus org.kde.KWin /KWin reconfigure 2>/dev/null || true
}

# Set the full _NET_DESKTOP_NAMES property (all workspace names)
_ewmh_names() {
    /usr/bin/python3 - "$@" <<'PYEOF'
import sys
from Xlib import X, display
names = sys.argv[1:]
d = display.Display()
root = d.screen().root
raw = ('\x00'.join(names) + '\x00').encode('utf-8')
root.change_property(d.intern_atom('_NET_DESKTOP_NAMES'),
    d.intern_atom('UTF8_STRING'), 8, raw)
d.sync()
PYEOF
}

ewmh_rename() {
    local idx=$1 new_name=$2
    _ws_names_and_index
    [[ -z ${WSN[idx]+x} ]] && die "Invalid workspace index"
    WSN[idx]=$new_name
    _ewmh_names "${WSN[@]}"
}

# --- X11 rename dispatch ---
x11_rename_at() {
    case $(wm_detect) in
        xfce)   xfce_rename "$1" "$2" ;;
        i3)     i3_rename "$1" "$2" ;;
        bspwm)  bspwm_rename "$1" "$2" ;;
        gnome)  gnome_rename "$1" "$2" ;;
        kde)    kde_rename "$1" "$2" ;;
        *)      ewmh_rename "$1" "$2" ;;
    esac
}

x11_rename() {
    x11_rename_at "$(_cur_ws_idx)" "$*"
}

# --- main ---

if [[ $# -gt 0 ]]; then
    x11_rename "$@"
else
    x11_switch
fi
