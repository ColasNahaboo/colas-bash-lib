#!/bin/bash

die() { echo "$@" >&2; exit 1; }

# --- backend detection ---
if [[ -n $WAYLAND_DISPLAY ]]; then
    backend=wayland
elif [[ -n $DISPLAY ]]; then
    backend=x11
else
    die "No display found"
fi

# --- X11 desktops ---
# stdout: tab-separated index, marker (*/-), name
x11_desktops() {
    while read -r line; do
        [[ $line =~ ^([0-9]+)[[:space:]]+([*\-]).*WA:[[:space:]]*[0-9,]+[[:space:]]+[0-9x]+[[:space:]]+(.*)$ ]] &&
            printf '%s\t%s\t%s\n' "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" "${BASH_REMATCH[3]}"
    done < <(wmctrl -d)
}

# --- window classes on a given desktop ---
x11_window_classes() {
    local desk=$1
    wmctrl -lx | awk -v d="$desk" '
        $2 == d {
            split($3, a, ".")
            c = a[length(a)]
            if (!seen[c]++) print c
        }
    ' | sort | paste -sd, - | sed 's/,/, /g'
}

# --- popup menu ---
popup_menu() {
    local title=$1 width=$(( ($2 * 5) / 2))
    local -a items=("${@:3}")
    printf '%s\n' "${items[@]}" |
        rofi -dmenu -markup -markup-rows \
             -p "$title" -i -no-custom \
             -theme-str "element-text { font: \"Monospace 32\"; } window { width: ${width}ch; } listview { fixed-height: false; dynamic: true; lines: 20; }" \
             -kb-custom-1 "F1" -kb-custom-2 "F2" -kb-custom-3 "F3" \
             -kb-custom-4 "F4" -kb-custom-5 "F5" -kb-custom-6 "F6" \
             -kb-custom-7 "F7" -kb-custom-8 "F8" -kb-custom-9 "F9" \
             -kb-custom-10 "F10" -kb-custom-11 "F11" -kb-custom-12 "F12" \
             2>/dev/null
}

# --- X11 switch ---
x11_switch() {
    local maxwidth=8
    declare -a items=()
    while IFS=$'\t' read -r idx mark name; do
        local classes display width line
        [[ $name =~ ^Workspace\ ([0-9]+)$ ]] && name="ws_${BASH_REMATCH[1]}"
        ((idx < 9)) && pad=' ' || pad=''
        ppad="$(padto "$name")"
        classes=$(x11_window_classes "$idx")
        line="$idx $pad$name$ppad| "
        ((width = ${#line} + (${#classes} / 2) + 1))
        ((width > maxwidth)) && ((maxwidth=width))
        display="<span font='Monospace 32'>$((idx + 1)) $pad$name$ppad| </span>"
        [[ -n $classes ]] && display+="<span font='Sans 16'>$classes</span>"
        items+=("$display")
    done < <(x11_desktops)

    local output rc idx
    output=$(popup_menu "Switch workspace (arrows+enter, or Fn)" $maxwidth "${items[@]}")
    rc=$?

    case $rc in
        0)  idx=$(sed 's/<[^>]*>//g' <<<"$output" | awk '{print $1}')
            [[ -n $idx ]] && idx=$((idx - 1)) ;;
        1[0-9]|2[01]) idx=$((rc - 10)) ;;  # F1-F12
        *) exit 0 ;;
    esac
    [[ -n $idx ]] && wmctrl -s "$idx"
}

spaces='                                                                       '
padto(){
    local l=$(( (${#1} / 4 + 1) * 4 - ${#1}))
    ((l > 0)) && echo "${spaces:0:$l}" || echo -n
}

# --- X11 rename ---
x11_rename() {
    local new_name=$*
    declare -a names=()
    local current_idx

    while IFS=$'\t' read -r idx mark name; do
        names[idx]=$name
        [[ $mark == '*' ]] && current_idx=$idx
    done < <(x11_desktops)

    [[ -z $current_idx ]] && die "Could not determine current workspace"

    names[current_idx]=$new_name

    local wm_name
    wm_name=$(wmctrl -m 2>/dev/null | awk -F': ' '/^Name:/ {print $2}')

    case $wm_name in
        Xfwm4)
            command -v xfconf-query &>/dev/null || die "xfconf-query not found"
            local -a xf_args=()
            for n in "${names[@]}"; do
                xf_args+=(-t string -s "$n")
            done
            xfconf-query -c xfwm4 -p /general/workspace_names "${xf_args[@]}" 2>&1
            ;;
        *)
            die "Workspace rename not supported for WM: ${wm_name:-unknown}"
            ;;
    esac
}

# --- Wayland ---
wayland_switch() {
    if command -v swaymsg &>/dev/null; then
        local -a names
        readarray -t names < <(swaymsg -t get_workspaces -r 2>/dev/null | jq -r '.[].name')
        local selection width=24
        for name in "${names[@]}"; do
            ((${#name} > width)) && width=${#name}
        done
        selection=$(popup_menu "Switch workspace" "$width" "${names[@]}") || exit 0
        [[ -n $selection ]] && swaymsg workspace "$selection" >/dev/null 2>&1
    else
        die "Wayland: only Sway is supported"
    fi
}

wayland_rename() {
    command -v swaymsg &>/dev/null || die "Wayland: only Sway is supported"
    swaymsg rename workspace to "$*" >/dev/null 2>&1
}

# --- main ---
if [[ $# -gt 0 ]]; then
    case $backend in
        x11) x11_rename "$@" ;;
        wayland) wayland_rename "$@" ;;
    esac
else
    case $backend in
        x11) x11_switch ;;
        wayland) wayland_switch ;;
    esac
fi
